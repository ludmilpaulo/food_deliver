# Next.js Environment Variables Example

# API Configuration
NEXT_PUBLIC_BASE_API=https://www.kudya.store
# For local development (Kudya backend — www_kudya_shop):
# NEXT_PUBLIC_BASE_API=http://127.0.0.1:8000
# Note: port 8001 may be used by a different Django project without /api/auth/login/

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_maps_api_key_here

# App URL (canonical public origin for OAuth redirects and legal pages)
NEXT_PUBLIC_APP_URL=https://sd-kudya.vercel.app

# Social login — public client IDs only (never secrets)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=

# Analytics (do not hardcode tokens in source)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Error monitoring (recommended for production)
NEXT_PUBLIC_SENTRY_DSN=

